    {
      "id": "errors",
      "label": "Error tracker",
      "type": "button",
      "host": "errors.example.test",
      "home": "https://errors.example.test/auth/login/",
      "signIn": {
        "path": "/auth/login",
        "button": {
          "selectors": [
            "a[href*=\"/identity/login/google\"]",
            "a[href*=\"provider=google\"]"
          ],
          "texts": [
            "Google",
            "Sign in with Google",
            "Continue with Google"
          ]
        }
      },
      "google": {
        "appNames": [
          "errors"
        ]
      },
      "handover": [
        {
          "path": "/auth/2fa",
          "selectors": [
            "input[name=\"otp\"]",
            "input[autocomplete=\"one-time-code\"]",
            "input[inputmode=\"numeric\"]",
            "input[type=\"text\"]"
          ],
          "label": "Error tracker's 2FA code box",
          "pageLabel": "Error tracker's 2FA page",
          "waitingFor": "your 2FA code"
        }
      ],
      "notSignedIn": [
        "/auth/*"
      ],
      "reloadOnInstall": [
        "https://errors.example.test/auth/login*"
      ]
    },
    {
      "id": "internal-local",
      "type": "button",
      "label": "Internal app (local)",
      "host": "internal.test",
      "home": "https://internal.test/portal",
      "matches": [
        "https://internal.test/portal*"
      ],
      "signIn": {
        "path": "/portal",
        "button": {
          "selectors": [
            "form[action$=\"/portal/auth/saml\"] button[type=\"submit\"]",
            "form[action$=\"/portal/auth/saml\"] [type=\"submit\"]"
          ]
        },
        "reloadIfOlderThanMinutes": 5
      },
      "google": {
        "mentions": [
          "saml2"
        ],
        "appNames": [
          "internal"
        ]
      },
      "handover": [
        {
          "path": "/portal/mfa/verify",
          "selectors": [
            "input[name$=\"[code]\"]",
            "input[autocomplete=\"one-time-code\"]",
            "input[type=\"text\"]",
            "input[type=\"number\"]"
          ],
          "label": "Internal app (local)'s two-factor code box",
          "pageLabel": "Internal app (local)'s two-factor page",
          "waitingFor": "your two-factor code"
        },
        {
          "path": "/portal/mfa/method",
          "selectors": [
            "input[type=\"radio\"]"
          ],
          "label": "Internal app (local)'s two-factor delivery choice",
          "pageLabel": "Internal app (local)'s two-factor page",
          "waitingFor": "you to choose how to get your two-factor code"
        }
      ],
      "notSignedIn": [
        "/portal",
        "/portal/login*",
        "/portal/auth*",
        "/portal/mfa*"
      ],
      "reloadOnInstall": [
        "https://internal.test/portal",
